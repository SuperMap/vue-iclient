{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "preserve",
    "lib": ["ES2018", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "paths": {
      "*": ["node_modules/*", ".pnpm/*"]
    },
    "types": ["vue", "geojson"]
  },
  "include": ["packages/mapboxgl", "typings/env.d.ts", "typings/mapboxgl-global.d.ts"],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/__tests__/**/*",
    "**/demo/**/*",
    "**/gulpfile.ts",
    "**/*.md"
  ]
}
