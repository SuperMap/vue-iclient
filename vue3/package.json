{
  "name": "vue3",
  "version": "12.1.0-dev",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "module": "es/index.js",
  "typings": "es/index.d.ts",
  "scripts": {
    "test:unit": "vitest run --coverage",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "dev": "pnpm build-routes && pnpm --dir ./site dev",
    "build:site": "pnpm --dir ./site build",
    "clean": "pnpm run clean:dist && pnpm run -r --parallel clean",
    "clean:dist": "rimraf dist",
    "build-routes": "pnpm --dir tools/build build-routes --pkg mapboxgl",
    "build-mapboxgl": "pnpm --dir tools/build start --pkg mapboxgl",
    "build-mapboxgl:theme": "pnpm --dir packages/mapboxgl/theme-chalk build",
    "stub": "pnpm run -r --parallel stub",
    "typecheck": "run-p typecheck:web typecheck:core typecheck:controllers-mapboxgl",
    "typecheck:web": "vue-tsc -p tsconfig.web.json --composite false --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json --composite false --noEmit",
    "typecheck:controllers-mapboxgl": "tsc -p tsconfig.controllers.mapboxgl.json --composite false --noEmit",
    "postinstall": "pnpm stub"
  },
  "peerDependencies": {
    "vue": ">=3.5.26",
    "@supermapgis/iclient-common": "^12.0.1-r",
    "@supermapgis/iclient-mapboxgl": "^12.0.1-r"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@videojs-player/vue": "^1.0.0",
    "@supermapgis/common/components": "workspace:*",
    "@supermapgis/mapboxgl/components": "workspace:*",
    "@types/geojson": "^7946.0.16",
    "@types/lodash": "^4.14.182",
    "@types/lodash-es": "^4.17.6",
    "@types/mapbox-gl": "^3.4.1",
    "ant-design-vue": "^4.2.6",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "flv.js": "^1.6.2",
    "interactjs": "1.9.7",
    "lodash-es": "^4.17.21",
    "lodash.clonedeep": "^4.5.0",
    "lodash.uniqueid": "^4.0.1",
    "mapbox-gl-compare-enhanced": "^1.0.0",
    "omit.js": "^2.0.2",
    "quill": "2",
    "resize-detector": "^0.2.2",
    "swiper": "^12.1.2",
    "vue-echarts": "^8.0.0",
    "vue-quilly": "^1.1.5",
    "vue3-count-to": "^1.1.2",
    "vue-video-player": "^6.0.0",
    "video.js": "~7.20.1",
    "videojs-flvjs-es6": "^1.0.1"
  },
  "devDependencies": {
    "@pnpm/find-workspace-packages": "^4.0.16",
    "@supermapgis/build": "workspace:*",
    "@supermapgis/build-utils": "workspace:*",
    "@supermapgis/common/hooks": "workspace:*",
    "@supermapgis/common/locale": "workspace:*",
    "@supermapgis/common/theme-chalk": "workspace:*",
    "@supermapgis/common/utils": "workspace:*",
    "@supermapgis/mapboxgl/hooks": "workspace:*",
    "@supermapgis/mapboxgl/theme-chalk": "workspace:*",
    "@supermapgis/mapboxgl/utils": "workspace:*",
    "@tsconfig/node22": "^22.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/eslint-plugin": "1.1.20",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/runtime-core": "^3.5.26",
    "@vue/runtime-dom": "^3.5.26",
    "@vue/shared": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.1.3",
    "csstype": "3.1.3",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "jsdom": "^25.0.1",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "source-map-js": "1.0.2",
    "typescript": "~5.6.3",
    "vitest": "^3.0.5",
    "vitest-sonar-reporter": "^2.0.0",
    "vue-iclient-controllers-mapboxgl": "workspace:*",
    "vue-iclient-core": "workspace:*",
    "vue-iclient-static": "workspace:*",
    "vue-tsc": "^2.2.2"
  }
}
