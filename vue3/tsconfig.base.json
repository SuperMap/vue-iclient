{
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "target": "es2020",
    "module": "esnext",
    "sourceMap": false,
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "removeComments": false,
    "noImplicitAny": false,
    "pretty": true,
    "preserveSymlinks": true,
    "jsx": "preserve",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "paths": {
      "*": [
        "node_modules/*",
        ".pnpm/*",
      ],
      "@supermapgis/common/": [
        "packages/common/"
      ],
      "@supermapgis/mapboxgl/": [
        "packages/mapboxgl/"
      ],
      "@supermapgis/iclient-components-core": [
        "../core/index.ts"
      ],
      "@supermapgis/iclient-components-core/core": [
        "../core/index.ts"
      ],
      "@supermapgis/iclient-components-core/core/*": [
        "../core/*"
      ],
      "@supermapgis/iclient-components-core/mapboxgl": [
        "../controllers/mapboxgl/index.ts"
      ],
      "@supermapgis/iclient-components-core/mapboxgl/*": [
        "../controllers/mapboxgl/*"
      ],
      "@supermapgis/iclient-components-core/static/*": [
        "../static/*"
      ]
    },
    "types": [
      "mapbox-gl",
      "vue",
      "@vue/runtime-dom",
      "geojson"
    ]
  }
}
