{
  "name": "@supermapgis/vue-iclient",
  "version": "12.1.2",
  "description": "SuperMap iClient for Vue.js",
  "homepage": "https://iclient.supermap.io",
  "scripts": {
    "prepare": "husky install",
    "test:vue3": "pnpm --dir ./vue3 test:unit",
    "dev:vue3": "pnpm --dir ./vue3 dev",
    "typecheck:vue3": "pnpm --dir ./vue3 typecheck",
    "lint:vue3": "pnpm --dir ./vue3 lint",
    "stylelint:vue3": "pnpm --dir ./vue3 stylelint",
    "build-mapboxgl:vue3": "pnpm --dir ./vue3 build-mapboxgl",
    "publish-mapboxgl:vue3": "pnpm publish ./vue3/dist/vue3-iclient-mapboxgl",
    "build:iclient-components-core": "pnpm --dir controllers/mapboxgl run build",
    "publish:iclient-components-core": "pnpm run build:iclient-components-core && pnpm publish ./controllers/mapboxgl/dist --no-git-checks"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 9"
  ],
  "author": "SuperMap_FE",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuperMap/vue-iclient.git"
  },
  "keywords": [
    "SuperMap",
    "Mapbox GL",
    "Vue"
  ],
  "jestSonar": {
    "reportPath": "test/unit/report",
    "reportFile": "test-reporter.xml",
    "indent": 4,
    "reportedFilePath": "relative"
  },
  "engines": {
    "npm": ">=7.0.0"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@supermapgis/iclient-common": "^12.1.0-r",
    "@supermapgis/iclient-mapboxgl": "^12.1.0-r"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.4.3",
    "mapbox-gl": "^1.13.0",
    "rollup-plugin-esbuild": "^6.1.1",
    "source-map-js": "1.0.2",
    "vue": "^3.5.26",
    "@supermapgis/iclient-components-core": "workspace:*"
  },
  "lint-staged": {
    "vue3/**/*.{vue,ts,tsx}": "pnpm typecheck:vue3",
    "vue3/**/*.{vue,js,ts,jsx,tsx,md,json}": "pnpm --dir ./vue3 lint"
  }
}
